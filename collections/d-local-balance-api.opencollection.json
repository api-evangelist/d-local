{
  "opencollection": "1.0.0",
  "info": {
    "name": "dLocal Cards Accounts Balance API",
    "version": "2.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Balance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Payouts Balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dlocal.com/payouts/v3/balance"
          },
          "docs": "Retrieve the merchant's available payout balance."
        }
      ]
    }
  ],
  "bundled": true
}